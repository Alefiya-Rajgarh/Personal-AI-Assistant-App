# Database
POSTGRES_USER=assistant_ai
POSTGRES_PASSWORD=assistant_ai_password
POSTGRES_DB=assistant_ai
DATABASE_URL=postgresql+asyncpg://assistant_ai:assistant_ai_password@postgres:5432/assistant_ai

# Redis
REDIS_URL=redis://redis:6379/0

# AI providers
OPENAI_API_KEY=

# Firebase
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase.json

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Observability
SENTRY_DSN=

# Security
SECRET_KEY=
